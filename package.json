{
  "name": "font-minifier",
  "version": "0.0.1",
  "keywords": [
    "cli",
    "compress",
    "compressor",
    "font",
    "fontmin",
    "javascript",
    "typescript",
    "min",
    "minification",
    "minifier",
    "minify",
    "optimize",
    "optimizer",
    "pack",
    "packer",
    "parse",
    "parser",
    "uglifier",
    "uglify"
  ],
  "description": "Typescript-based Font compressor/minifier (with Node.js support)",
  "homepage": "https://github.com/xykong/font-minifier",
  "author": "xy.kong@gmail.com",
  "private": false,
  "types": "build/types/types.d.ts",
  "bin": {
    "font-minifier": "bin/font-minifier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xykong/font-minifier.git"
  },
  "bugs": {
    "url": "https://github.com/xykong/font-minifier/issues"
  },
  "scripts": {
    "format": "prettier --write **/*.{js,ts,tsx,json}",
    "lint": "tslint -p .",
    "clean-build": "rm -rf ./build",
    "compile": "tsc -p .",
    "copy-templates": "if [ -e ./src/templates ]; then cp -a ./src/templates ./build/; fi",
    "build": "yarn format && yarn lint && yarn clean-build && yarn compile && yarn copy-templates",
    "prepublishOnly": "yarn build",
    "test": "jest",
    "watch": "jest --watch",
    "snapupdate": "jest --updateSnapshot",
    "coverage": "jest --coverage"
  },
  "files": [
    "tsconfig.json",
    "tslint.json",
    "build",
    "LICENSE",
    "readme.md",
    "docs",
    "bin"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "gluegun": "^5.2.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "prettier": "^1.12.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.17.0",
    "tslint-config-standard": "^8.0.1",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  }
}
